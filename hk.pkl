amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

min_hk_version = "1.52.0"

local checks = new Mapping<String, Step> {
    ["hk-test"] = Builtins.hk_test
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["test-explanations"] = new Step {
        glob = List(
            "crates/**/*.rs",
            "tools/**/*.rs",
            "CONTRIBUTING.md",
        )
        check = "cargo xtask check test-explanations"
    }
    ["librarian-corpus-integrity"] = new Step {
        glob = List(
            "methexis/knowledge/**/*.md",
            "methexis/review-projections/**/*.md",
            "methexis/owners/**/*.yaml",
            "methexis/sources/**/*.yaml",
        )
        check = "cargo test --quiet --locked -p librarian --test live_corpus"
    }
    ["librarian-discovery"] = new Step {
        glob = List(
            "tools/librarian/**/*.json",
            "tools/librarian/**/*.md",
            "tools/librarian/**/*.rs",
            "tools/librarian/**/*.yaml",
            "tools/librarian/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p librarian"
    }
    ["methexis-corpus-integrity"] = new Step {
        glob = List(
            "methexis/**/*.md",
            "methexis/**/*.yaml",
        )
        check = "cargo xtask check methexis-check-for-stage"
    }
    ["methexis-validation"] = new Step {
        glob = List(
            "tools/methexis/**/*.json",
            "tools/methexis/**/*.md",
            "tools/methexis/**/*.rs",
            "tools/methexis/**/*.yaml",
            "tools/methexis/tests/fixtures/**/*",
            "tools/methexis/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p methexis"
    }
    ["yo-tui-tests"] = new Step {
        glob = List(
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p yo-tui"
    }
    ["yo-cli-tests"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p yo-cli"
    }
    ["yo-cli-lints"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo clippy --quiet --locked -p yo-cli --all-targets -- -D warnings"
    }
    ["yo-cli-unix-matrix"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            ".github/workflows/unix-compile.yml",
            "tools/validation/yo-cli-unix-matrix.sh",
            "tools/validation/yo-cli-unix-matrix-tests.sh",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "bash tools/validation/yo-cli-unix-matrix-tests.sh && bash tools/validation/yo-cli-unix-matrix.sh"
    }
    ["developer-docs"] = new Step {
        glob = List(
            "docs/**/*.md",
            "docs/**/*.css",
            "docs/**/*.hbs",
            "docs/**/*.html",
            "docs/**/*.js",
            "docs/book.toml",
            "docs/ko/book.toml",
            "docs/ko/source.sha256",
            "tools/validation/developer-docs-build.sh",
            "tools/validation/developer-docs.sh",
            "tools/validation/developer-docs-translations.sh",
            "tools/validation/developer-docs-translations-tests.sh",
        )
        check = "bash tools/validation/developer-docs.sh"
    }
    ["xtask-tests"] = new Step {
        glob = List(
            ".cargo/config.toml",
            "AGENTS.md",
            "CONTRIBUTING.md",
            "hk.pkl",
            "tools/xtask/**/*.rs",
            "tools/xtask/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p xtask"
    }
}

hooks {
    ["pre-commit"] {
        steps = checks
    }
    ["check"] {
        steps = checks
    }
    ["fix"] {
        fix = true
        steps = checks
    }
    ["commit-msg"] {
        steps {
            ["developer-docs-impact"] {
                check = "cargo xtask check developer-docs-impact {{commit_msg_file}}"
            }
            ["slice-review-impact"] {
                check = "cargo xtask check slice-review-impact {{commit_msg_file}}"
            }
        }
    }
}
