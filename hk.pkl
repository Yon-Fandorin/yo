amends "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.52.0/hk@1.52.0#/Builtins.pkl"

min_hk_version = "1.52.0"

local checks = new Mapping<String, Step> {
    ["hk-test"] = Builtins.hk_test
    ["cargo-fmt"] = Builtins.cargo_fmt
    ["test-explanations"] = new Step {
        glob = List(
            "crates/**/*.rs",
            "tools/librarian/**/*.rs",
            "tools/methexis/**/*.rs",
            "tools/validation/test-explanations.sh",
            "CONTRIBUTING.md",
        )
        check = "bash tools/validation/test-explanations.sh"
    }
    ["librarian-discovery"] = new Step {
        glob = List(
            "methexis/knowledge/**/*.md",
            "methexis/review-projections/**/*.md",
            "tools/librarian/**/*.json",
            "tools/librarian/**/*.md",
            "tools/librarian/**/*.rs",
            "tools/librarian/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p librarian"
    }
    ["methexis-draft"] = new Step {
        glob = List(
            "methexis/**/*.md",
            "methexis/**/*.yaml",
            "tools/methexis/**/*.json",
            "tools/methexis/**/*.md",
            "tools/methexis/**/*.rs",
            "tools/methexis/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo run --quiet --locked -p methexis -- check"
    }
    ["methexis-tests"] = new Step {
        glob = List(
            "methexis/**/*.md",
            "methexis/**/*.yaml",
            "tools/methexis/**/*.json",
            "tools/methexis/**/*.md",
            "tools/methexis/**/*.rs",
            "tools/methexis/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p methexis"
    }
    ["yo-tui-tests"] = new Step {
        glob = List(
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p yo-tui"
    }
    ["yo-cli-tests"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo test --quiet --locked -p yo-cli"
    }
    ["yo-cli-lints"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "cargo clippy --quiet --locked -p yo-cli --all-targets -- -D warnings"
    }
    ["yo-cli-unix-matrix"] = new Step {
        glob = List(
            "crates/yo-cli/**/*.rs",
            "crates/yo-cli/Cargo.toml",
            "crates/yo-tui/**/*.rs",
            "crates/yo-tui/Cargo.toml",
            ".github/workflows/unix-compile.yml",
            "tools/validation/yo-cli-unix-matrix.sh",
            "Cargo.lock",
            "Cargo.toml",
        )
        check = "bash tools/validation/yo-cli-unix-matrix.sh"
    }
    ["developer-docs"] = new Step {
        glob = List(
            "docs/**/*.md",
            "docs/**/*.css",
            "docs/**/*.hbs",
            "docs/**/*.js",
            "docs/book.toml",
            "tools/validation/developer-docs.sh",
            "tools/validation/developer-docs-impact.sh",
            "tools/validation/developer-docs-impact-tests.sh",
        )
        check = "bash tools/validation/developer-docs.sh && bash tools/validation/developer-docs-impact-tests.sh"
    }
    ["slice-review-impact-tests"] = new Step {
        glob = List(
            "AGENTS.md",
            "CONTRIBUTING.md",
            "hk.pkl",
            "tools/validation/slice-review-impact.sh",
            "tools/validation/slice-review-impact-tests.sh",
        )
        check = "bash tools/validation/slice-review-impact-tests.sh"
    }
}

hooks {
    ["pre-commit"] {
        steps = checks
    }
    ["check"] {
        steps = checks
    }
    ["fix"] {
        fix = true
        steps = checks
    }
    ["commit-msg"] {
        steps {
            ["developer-docs-impact"] {
                check = "bash tools/validation/developer-docs-impact.sh {{commit_msg_file}}"
            }
            ["slice-review-impact"] {
                check = "bash tools/validation/slice-review-impact.sh {{commit_msg_file}}"
            }
        }
    }
}
